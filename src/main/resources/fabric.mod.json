{
  "schemaVersion": 1,
  "id": "optionsreload",
  "version": "${version}",
  "name": "Options Reload",
  "description": "A simple mod that adds F3 keybind to reload the game options from options.txt",
  "license": "LGPL-3",
  "environment": "client",
  "entrypoints": {
    "client-init": [
      "com.awakenedredstone.optionsreload.OptionsReload"
    ]
  },
  "depends": {
    "fabricloader": ">=0.14.12",
    "minecraft": "1.8.9",
    "osl-entrypoints": "*",
    "osl-keybinds": "*"
  }
}
